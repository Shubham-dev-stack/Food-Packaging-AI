# Application Configuration
ENVIRONMENT=development
PROJECT_NAME="AI Food Packaging Material Recommendation System"
API_V1_PREFIX=/api
HOST=127.0.0.1
PORT=8000

# CORS Settings (JSON list or comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database URL (SQLite for local development, PostgreSQL for deployment)
DATABASE_URL="sqlite:///./data/food_packaging.db"
